{
  "name": "tien-len-online",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/server & npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/server && npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/server",
    "lint": "npm run lint --workspace apps/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.1",
    "postcss": "^8.5.33"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
